{
  "expo": {
    "name": "DoorDrop",
    "slug": "DoorDrop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/image1-app-icon-pro.png",
    "scheme": "doordrop",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doordrop.app"
    },
    "android": {
      "package": "com.doordrop.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/image1-adaptive-foreground-minimal.png",
        "monochromeImage": "./assets/images/doordrop-adaptive-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/image1-app-icon-pro.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/image1-app-icon-pro.png",
            "backgroundColor": "#ffffff"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "googleAuth": {
        "clientId": "590216923570-btv143fr3at96oat9olcgklf9ko3t5fi.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "c2343112-5064-4d1f-bee7-920713b37d21"
      }
    },
    "owner": "lusaya"
  }
}
